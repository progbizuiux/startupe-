# Copy to .env.local and fill in. Only NEXT_PUBLIC_* vars reach the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Progbiz CRM: Third Party Leads API ------------------------------------
# Where both registration forms and the /contact form send their leads
# (src/lib/crm.js). Without all
# three the API route only logs in development, and refuses submissions in
# production rather than dropping them.
# The working endpoint is /api/website/save-enquiry. The /webhook/third-party-leads
# path in the PDF answers "No specific integration available for this branch".
CRM_LEADS_URL=https://erp.progbiz.io/api/website/save-enquiry
# Integration API key, sent as the X-Api-Key header. Provided by Progbiz.
CRM_API_KEY=
# CRM branch the leads belong to, an integer. Provided by Progbiz.
CRM_BRANCH_ID=
# Required: the address the CRM emails each new lead to. Without it the endpoint
# answers 400 "The value cannot be an empty string. (Parameter 'addresses')".
CRM_NOTIFY_EMAIL=startupvadakara@gmail.com
# Optional: the source name shown on the lead. Left unset, the CRM uses the
# source configured for this integration, which is usually what you want.
# CRM_LEAD_SOURCE=Startup E Website
# Debug hatches for the CRM, both off by default. The API answers 500 with an
# empty body on leads it dislikes, so these let you strip parts of the payload
# without a code change and re-test with scripts/crm-smoke-test.mjs.
#   CRM_ADDITIONAL_DATA=off      drop the custom-field map
#   CRM_DROP=state,country       drop named top-level fields

# --- Confirmation email to the registrant (src/lib/registration-email.js) ----
# NOT the same as CRM_NOTIFY_EMAIL above, which tells the OFFICE a lead arrived.
# This is the mail the person who filled /register gets: "your registration went
# through", their registration ID, and the pass attached as a PDF.
#
# Sent through Gmail's own SMTP as the office account. It cannot go through a
# transactional API (Resend, SendGrid): those need the sending domain proved
# with DNS records, and nobody can add DNS records to gmail.com.
#
# Both must be set or nothing is sent and the route logs a warning.
#
# The Gmail account the mail is sent from and as.
MAIL_USER=startupvadakara@gmail.com
# A Google APP PASSWORD, not the account password. 16 characters, no spaces.
# The account needs 2-step verification ON first, then generate one at
# https://myaccount.google.com/apppasswords
# Treat it like a password: it is never committed, and it grants mail access to
# the account until revoked at that same page.
MAIL_APP_PASSWORD=
# Optional: display name in front of the address. Gmail rewrites the address
# itself to MAIL_USER regardless.
# MAIL_FROM=Startup E+ <startupvadakara@gmail.com>
# Optional: where replies go. Defaults to MAIL_USER.
MAIL_REPLY_TO=
#
# Sending limits: a free Gmail account sends to ~500 recipients a day, Google
# Workspace ~2000. Past that Google blocks sending for 24 hours.
