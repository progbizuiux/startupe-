# Copy to .env.local and fill in. Only NEXT_PUBLIC_* vars reach the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Progbiz CRM: Third Party Leads API ------------------------------------
# Where both registration forms and the /contact form send their leads
# (src/lib/crm.js). Without all
# three the API route only logs in development, and refuses submissions in
# production rather than dropping them.
# The working endpoint is /api/website/save-enquiry. The /webhook/third-party-leads
# path in the PDF answers "No specific integration available for this branch".
CRM_LEADS_URL=https://erp.progbiz.io/api/website/save-enquiry
# Integration API key, sent as the X-Api-Key header. Provided by Progbiz.
CRM_API_KEY=
# CRM branch the leads belong to, an integer. Provided by Progbiz.
CRM_BRANCH_ID=
# Required: the address the CRM emails each new lead to. Without it the endpoint
# answers 400 "The value cannot be an empty string. (Parameter 'addresses')".
CRM_NOTIFY_EMAIL=startupvadakara@gmail.com
# Optional: the source name shown on the lead. Left unset, the CRM uses the
# source configured for this integration, which is usually what you want.
# CRM_LEAD_SOURCE=Startup E Website
# Debug hatches for the CRM, both off by default. The API answers 500 with an
# empty body on leads it dislikes, so these let you strip parts of the payload
# without a code change and re-test with scripts/crm-smoke-test.mjs.
#   CRM_ADDITIONAL_DATA=off      drop the custom-field map
#   CRM_DROP=state,country       drop named top-level fields

# --- Confirmation email to the registrant (src/lib/registration-email.js) ----
# NOT the same as CRM_NOTIFY_EMAIL above, which tells the OFFICE a lead arrived.
# This is the mail the person who filled /register gets: their registration ID
# and the pass attached as a PDF.
#
# TWO TRANSPORTS. Resend is used when RESEND_API_KEY and MAIL_FROM are both set;
# otherwise it falls back to Gmail SMTP. Set neither pair and nothing is sent and
# the route logs a warning.
#
# --- preferred: your own domain through Resend -----------------------------
# Why: mail from a free @gmail.com account, carrying a 1.8MB PDF, to someone who
# has never corresponded with it, is the shape of a phishing message, and Gmail
# files much of it as spam. A domain with SPF/DKIM/DMARC behind a transactional
# provider is what makes the same message land in the inbox.
#
# Setup: create an account at resend.com, add the domain startupeplus.com, and
# add the DNS records it gives you at GoDaddy (the domain's nameservers are
# ns49/ns50.domaincontrol.com). Then:
RESEND_API_KEY=
# The From address. Its domain must be the verified one.
# e.g. MAIL_FROM=Startup E+ <noreply@startupeplus.com>
MAIL_FROM=
#
# --- fallback: the office Gmail over SMTP ----------------------------------
# Works without any DNS, but see the spam note above.
# MAIL_USER is the Gmail account; MAIL_APP_PASSWORD is a Google APP PASSWORD
# (16 characters, not the account password). The account needs 2-step
# verification on first, then generate one at
# https://myaccount.google.com/apppasswords
MAIL_USER=
MAIL_APP_PASSWORD=
#
# Optional, used by both: where replies go. Defaults to the site contact address
# for Resend, or to MAIL_USER for Gmail.
MAIL_REPLY_TO=
#
# Gmail sending limits: ~500 recipients a day on a free account, ~2000 on Google
# Workspace. Resend's free tier is ~3000 a month.
